{
  "outputDirectory": "public",
  "functions": {
    "api/tenders.js": {
      "includeFiles": "data/**"
    },
    "api/admin.js": {
      "includeFiles": "data/**"
    },
    "api/cron.js": {
      "includeFiles": "data/**"
    },
    "api/dossier.js": {
      "maxDuration": 300
    },
    "api/status.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ]
}
